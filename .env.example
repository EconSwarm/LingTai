# Copy to .env (git-ignored). Values are read by config.toml via ${VAR}
# and by docker-compose. Never commit real keys.

# --- model provider keys (reference them from [llm].api_key) -------------------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- lingTai overrides (all optional; take precedence over config.toml) --------
# Path to the TOML config file
# LINGTAI_CONFIG=config/config.toml
# Where memory, goals, vault, audit log and sessions live (default ~/.lingtai)
# LINGTAI_DATA_DIR=~/.lingtai
# The agent's files (default: agent.workspace from config; ./workspace when the current directory has one, else <data_dir>/workspace)
# LINGTAI_WORKSPACE=./workspace
# openai | openai_responses | chatgpt | a catalogue id (deepseek, bailian, zhipu, openrouter, ...)
# LINGTAI_LLM_PROVIDER=openai
# LINGTAI_LLM_MODEL=deepseek-flash
# LINGTAI_LLM_BASE_URL=https://api.deepseek.com
# LINGTAI_LLM_API_KEY=
# auto | native | prompt
# LINGTAI_LLM_TOOL_MODE=native
# ask | strict | auto
# LINGTAI_SENTINEL_MODE=ask
# DEBUG | INFO | WARNING
# LINGTAI_LOG_LEVEL=INFO
# base64 Fernet key for the credential vault (default: file in data dir)
# LINGTAI_VAULT_KEY=
# App server (`lingtai serve`): bind address, port, and a fixed access token
# LINGTAI_SERVER_HOST=0.0.0.0
# LINGTAI_SERVER_PORT=8787
# LINGTAI_SERVER_TOKEN=
# set to 1 to run tests marked `live` against the configured model
# LINGTAI_LIVE=0
